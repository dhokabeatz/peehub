generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  retail
  agent
  admin
}

enum AuthProvider {
  local
  cognito
}

enum WalletTransactionType {
  credit
  debit
}

enum TransactionStatus {
  pending
  success
  failed
}

enum OrderStatus {
  pending
  processing
  completed
  failed
  cancelled
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String?      @unique
  phone        String?      @unique
  passwordHash String?      @map("password_hash")
  fullName     String       @map("full_name")
  role         UserRole     @default(retail)
  authProvider AuthProvider @default(local) @map("auth_provider")
  cognitoSub   String?      @unique @map("cognito_sub")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  wallet              Wallet?
  orders              Order[]
  walletTransactions  WalletTransaction[]
  paymentTransactions PaymentTransaction[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  processedOrders     Order[]              @relation("ProcessedBy")

  @@map("users")
}

model Wallet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id])
  walletTransactions  WalletTransaction[]
  paymentTransactions PaymentTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId      String                @map("wallet_id") @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  balanceBefore Decimal               @map("balance_before") @db.Decimal(12, 2)
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(12, 2)
  reference     String                @unique
  description   String?
  status        TransactionStatus     @default(pending)
  metadata      Json?
  createdAt     DateTime              @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order?

  @@map("wallet_transactions")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Network {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  code      String   @unique
  prefixes  String[]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  bundles Bundle[]
  orders  Order[]

  @@map("networks")
}

model Bundle {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId    String   @map("network_id") @db.Uuid
  name         String
  dataSizeMb   Int      @map("data_size_mb")
  validityDays Int      @map("validity_days")
  price        Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  network Network @relation(fields: [networkId], references: [id])
  orders  Order[]

  @@map("bundles")
}

model Order {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  bundleId            String      @map("bundle_id") @db.Uuid
  networkId           String      @map("network_id") @db.Uuid
  walletTransactionId String?     @unique @map("wallet_transaction_id") @db.Uuid
  recipientPhone      String      @map("recipient_phone")
  amount              Decimal     @db.Decimal(10, 2)
  status              OrderStatus @default(pending)
  adminNote           String?     @map("admin_note")
  processedBy         String?     @map("processed_by") @db.Uuid
  providerReference   String?     @map("provider_reference")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id])
  bundle            Bundle             @relation(fields: [bundleId], references: [id])
  network           Network            @relation(fields: [networkId], references: [id])
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  processor         User?              @relation("ProcessedBy", fields: [processedBy], references: [id])

  @@map("orders")
}

model PaymentTransaction {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  walletId          String            @map("wallet_id") @db.Uuid
  amount            Decimal           @db.Decimal(12, 2)
  provider          String
  providerReference String?           @unique @map("provider_reference")
  status            TransactionStatus @default(pending)
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("payment_transactions")
}
