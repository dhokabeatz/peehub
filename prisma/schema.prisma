generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  retail
  agent
  admin
}

enum AuthProvider {
  local
  cognito
}

enum WalletTransactionType {
  credit
  debit
}

enum TransactionStatus {
  pending
  success
  failed
}

enum OrderStatus {
  pending
  processing
  completed
  failed
  cancelled
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String?      @unique
  phone        String?      @unique
  passwordHash String?      @map("password_hash")
  fullName     String       @map("full_name")
  role         UserRole     @default(retail)
  authProvider AuthProvider @default(local) @map("auth_provider")
  cognitoSub   String?      @unique @map("cognito_sub")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  wallet              Wallet?
  orders              Order[]
  walletTransactions  WalletTransaction[]
  paymentTransactions PaymentTransaction[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  processedOrders     Order[]              @relation("ProcessedBy")

  @@map("users")
}

model Wallet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletTransactions  WalletTransaction[]
  paymentTransactions PaymentTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId      String                @map("wallet_id") @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  balanceBefore Decimal               @map("balance_before") @db.Decimal(12, 2)
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(12, 2)
  reference     String                @unique
  description   String?
  status        TransactionStatus     @default(pending)
  metadata      Json?
  createdAt     DateTime              @default(now()) @map("created_at")

  // Restrict: financial records must not be deleted while transactions reference them
  wallet      Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order       Order? @relation("OriginalDebit")
  refundOrder Order? @relation("RefundTransaction")

  @@index([walletId])
  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite index: find valid tokens per user (used on logout and token rotation)
  @@index([userId, revoked])
  // Index for scheduled cleanup of expired tokens
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Network {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  code      String   @unique
  prefixes  String[]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  bundles Bundle[]
  orders  Order[]

  @@map("networks")
}

model Bundle {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  networkId    String   @map("network_id") @db.Uuid
  name         String
  dataSizeMb   Int      @map("data_size_mb")
  validityDays Int      @map("validity_days")
  price        Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Restrict: can't delete a network while bundles reference it
  network Network @relation(fields: [networkId], references: [id], onDelete: Restrict)
  orders  Order[]

  // Prevent duplicate bundle names within the same network
  @@unique([networkId, name])
  // Composite index: primary query pattern — active bundles for a network
  @@index([networkId, isActive])
  @@map("bundles")
}

model Order {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  bundleId            String      @map("bundle_id") @db.Uuid
  // networkId is intentional denormalization — avoids joining through Bundle to get the
  // network on every order query, and preserves the network even if the bundle is updated.
  networkId           String      @map("network_id") @db.Uuid
  walletTransactionId       String?     @unique @map("wallet_transaction_id") @db.Uuid
  refundWalletTransactionId String?     @unique @map("refund_wallet_transaction_id") @db.Uuid
  recipientPhone      String      @map("recipient_phone")
  amount              Decimal     @db.Decimal(10, 2)
  status              OrderStatus @default(pending)
  adminNote           String?     @map("admin_note")
  processedBy         String?     @map("processed_by") @db.Uuid
  providerReference   String?     @map("provider_reference")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  bundle            Bundle             @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  network           Network            @relation(fields: [networkId], references: [id], onDelete: Restrict)
  // SetNull: if a wallet transaction is removed (should not happen in prod), the order
  // record is preserved but loses its payment link
  walletTransaction       WalletTransaction? @relation("OriginalDebit",   fields: [walletTransactionId],       references: [id], onDelete: SetNull)
  // SetNull: refund record is preserved on the order even if the wallet tx is somehow removed
  refundWalletTransaction WalletTransaction? @relation("RefundTransaction", fields: [refundWalletTransactionId], references: [id], onDelete: SetNull)
  // SetNull: if an admin account is deactivated/removed, orders they processed remain intact
  processor               User?              @relation("ProcessedBy", fields: [processedBy], references: [id], onDelete: SetNull)

  @@index([userId, createdAt]) // paginated user order history
  @@index([userId, status]) // filter user orders by status
  @@index([status, createdAt]) // admin queue sorted by creation time
  @@map("orders")
}

model PaymentTransaction {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  walletId          String            @map("wallet_id") @db.Uuid
  amount            Decimal           @db.Decimal(12, 2)
  provider          String
  providerReference String?           @unique @map("provider_reference")
  status            TransactionStatus @default(pending)
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Restrict: financial records must not be deleted while payment transactions exist
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@map("payment_transactions")
}
