# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require   # pooler (runtime)
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require            # direct (migrations)

# ─── Auth — JWT (local provider) ─────────────────────────────────────────────
AUTH_PROVIDER=local                   # local | cognito
JWT_SECRET=                           # min 32 chars — run: openssl rand -hex 32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECURE=false                   # true in production (requires HTTPS)

# ─── Auth — AWS Cognito (leave blank until migration) ─────────────────────────
# AWS_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=

# ─── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000  # set to your domain in production (e.g. https://yourdomain.com)

# ─── Seed — Demo / Admin accounts (used by prisma/seed.ts only) ──────────────
ADMIN_EMAIL=admin@peehub.com
ADMIN_PASSWORD=                           # min 8 chars
ADMIN_FULL_NAME=Admin User
DEMO_USER_EMAIL=demo@peehub.com
DEMO_USER_PASSWORD=                       # min 8 chars
DEMO_USER_FULL_NAME=Demo User
SEED_MODE=dev                             # dev = networks + admin + demo data | prod = networks + admin only

# ─── Bundle Fulfillment ───────────────────────────────────────────────────────
BUNDLE_PROVIDER=manual                # manual | api
# BUNDLE_API_BASE_URL=
# BUNDLE_API_KEY=

# ─── Payment Provider ─────────────────────────────────────────────────────────
PAYMENT_PROVIDER=stub                 # stub | hubtel | paystack
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
